# QQ 开放平台「开发设置」；请勿将真实密钥提交到 Git。
QQ_APP_ID=
QQ_APP_SECRET=
# 账号后台已确认可用 WebSocket，不需要公网 HTTPS 回调。
QQ_TRANSPORT=websocket
# 部署联调时显式启用；false 不连接真实 QQ，便于本地模拟验证。
QQ_GATEWAY_ENABLED=false
# 仅订阅群聊/单聊，不默认请求全部事件权限。
QQ_GATEWAY_INTENTS=33554432
QQ_GATEWAY_MAX_RETRIES=10
# 官方 botpy 当前使用此地址；后台文档指定新域名时可覆盖。
QQ_API_BASE=https://api.sgroup.qq.com
QQ_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
# true 仅模拟发送；收消息由 QQ_GATEWAY_ENABLED 独立控制。
QQ_DRY_RUN=true
ADMIN_TOKEN=replace-with-a-long-random-admin-token
DATA_DIR=data

# 支持 chat/completions + image_url 的多模态服务；不是纯文本模型。
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
VISION_MODEL=deepseek-flash
CHAT_MODEL=deepseek-flash
CHAT_ENABLED=false
AUTO_APPLY_AI=false
AI_CONFIDENCE_THRESHOLD=0.95
# QQ 附件域名白名单；不同账号的真实 CDN 域名需从回调核实后补充。
IMAGE_ALLOWED_HOSTS=multimedia.nt.qq.com,multimedia.nt.qq.com.cn,gchat.qpic.cn,c2cpicdw.qpic.cn
MAX_IMAGE_BYTES=10485760
RECONCILE_DAYS=14
# QQ 官方已停止主动推送。群聊/单聊采用各自的保守回复窗口。
REPLY_WINDOW_SECONDS=240
C2C_REPLY_WINDOW_SECONDS=3300

# 可选通用订单查询网关（协议见 docs/commerce-adapter.md）。
# 没有接口时保持为空，核对任务会标为待人工核对。
COMMERCE_BASE_URL=
COMMERCE_API_KEY=
